{
    "name": "icmbio/xform",
    "description": "Biblioteca PHP para processamento e manipulação de XForms do ICMBio",
    "type": "library",
    "license": "MIT",
    "keywords": ["xform", "xml", "forms", "survey", "icmbio", "data-collection"],
    "homepage": "https://gitlab.com/icmbio/xform-package",
    "authors": [
        {
            "name": "João Pedro Garcia",
            "email": "joao.garcia.bolsista@icmbio.gov.br",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Icmbio\\Xform\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Icmbio\\Xform\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
